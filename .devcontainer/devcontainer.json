{
  "name": "MediaShelf",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "containerEnv": {
    "HOST": "0.0.0.0",
    "PORT": "4175"
  },
  "forwardPorts": [
    4175
  ],
  "portsAttributes": {
    "4175": {
      "label": "MediaShelf",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm ci && npm run build",
  "postStartCommand": "nohup npm start > /tmp/mediashelf.log 2>&1 &"
}
