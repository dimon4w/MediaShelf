# Copy to .env and adjust. Every value is optional.

# Address and port of the production server (npm start).
# 127.0.0.1 = only this computer. 0.0.0.0 = also phones/tablets in the same Wi-Fi.
HOST=127.0.0.1
PORT=4173

# Where the SQLite database lives (relative to the project folder).
DATA_DIR=data

# Set to false after creating your accounts to stop new registrations.
ALLOW_REGISTRATION=true

# How long a sign-in lasts without activity, in days.
SESSION_DAYS=30

# Only behind a reverse proxy (Caddy, nginx) that terminates HTTPS.
TRUST_PROXY=false
# auto = Secure cookies when the request is HTTPS. always / never to force.
COOKIE_SECURE=auto
# Extra origins allowed to call the API, comma-separated (rarely needed).
ALLOWED_ORIGINS=

# fixtures = offline demo catalog (used by the end-to-end tests).
CATALOG_MODE=live
